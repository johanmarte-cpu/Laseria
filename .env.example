# Prisma datasource — Supabase Postgres. Get both connection strings from
# your Supabase project: Project Settings → Database → Connection string.
#
# DATABASE_URL = "Connection pooling" tab (port 6543, Transaction mode) —
#   used by the app at runtime. Must end in "?pgbouncer=true".
# DIRECT_URL   = "Direct connection" tab (port 5432) — used only by
#   `prisma migrate` / `prisma db push` to create/alter tables; pooled
#   connections don't support the session-level commands migrations need.
#
# Both contain your database password — never commit a filled-in .env.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres"

# Auth.js (NextAuth) — generate with `npx auth secret`
AUTH_SECRET="replace-with-a-long-random-string"
# Local dev: "http://localhost:3000". On Vercel: your production URL
# (e.g. "https://laseria.vercel.app"), set as a Vercel project env var.
NEXTAUTH_URL="http://localhost:3000"

# Email (Resend) — required for the Caja module's shift-closing report email.
# Create a free account at https://resend.com, generate an API key, and set:
# RESEND_API_KEY="re_xxxxxxxx"
# EMAIL_FROM="Lasería <onboarding@resend.dev>"   # sandbox sender, no domain verification needed for testing
# CASH_REPORT_EMAIL="gerencia@laseria.com"        # recipient of every "cierre de caja" report; can be a comma-separated list handled by Resend
RESEND_API_KEY=
EMAIL_FROM=
CASH_REPORT_EMAIL=

# Future integrations (not required for the MVP):
# STRIPE_SECRET_KEY=
# WHATSAPP_BUSINESS_TOKEN=
